# Copy this file to .env and fill in your bot token.
# Get a token from https://discord.com/developers/applications
BOT_TOKEN=your-bot-token-here

# Default time for daily chore reminders / month-end statements.
REMINDER_HOUR=8
REMINDER_MINUTE=0

# Default timezone (IANA name). Per-guild override settable via /setup.
TZ=America/New_York
